# -----------------------------------------------
# Contact form (Web3Forms — free tier)
# 1. Go to https://web3forms.com
# 2. Create a free access key with your email
#    (jahabarjavith111@gmail.com)
# 3. Paste it below (server-side only, never exposed
#    to the browser)
# Without this key the form shows an honest
# "email me directly" fallback instead of fake success.
# -----------------------------------------------
WEB3FORMS_ACCESS_KEY=

# -----------------------------------------------
# Production base URL, no trailing slash.
# Set this when you deploy to a custom domain —
# used for canonical/OG metadata, robots, and sitemap.
# -----------------------------------------------
NEXT_PUBLIC_SITE_URL=
